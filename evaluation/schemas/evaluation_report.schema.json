{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://taksitlio.dev/schemas/evaluation/evaluation_report.schema.json",
  "title": "CategoryMatchEvaluationReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "dataset_ref",
    "mode",
    "quality_gate",
    "metrics",
    "latency",
    "error_buckets"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "dataset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_id", "version", "split", "case_count"],
      "properties": {
        "dataset_id": {"type": "string"},
        "version": {"type": "string"},
        "split": {
          "type": "string",
          "enum": ["development", "validation", "holdout"]
        },
        "case_count": {"type": "integer", "minimum": 0},
        "immutable_hash": {"type": "string"}
      }
    },
    "mode": {
      "type": "string",
      "enum": ["FULL", "LEXICAL_ONLY", "VECTOR_ONLY", "ALIAS_ONLY", "DEGRADED"]
    },
    "policy": {
      "type": "object",
      "additionalProperties": true
    },
    "quality_gate": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status", "objective_score", "violations"],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ACCEPT",
            "REJECT",
            "PROVISIONAL_ACCEPT",
            "INSUFFICIENT_REVIEWED_DATA"
          ]
        },
        "objective_score": {"type": "number"},
        "objective_weights": {"type": "object"},
        "thresholds": {"type": "object"},
        "gate_profile": {"type": "string"},
        "violations": {
          "type": "array",
          "items": {"type": "string"}
        },
        "notes": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status_accuracy"],
      "properties": {
        "status_accuracy": {"$ref": "#/definitions/rate_or_number"},
        "matched": {"$ref": "#/definitions/prf1"},
        "ambiguous": {"$ref": "#/definitions/prf1"},
        "no_match": {"$ref": "#/definitions/prf1"},
        "top_1_accepted_accuracy": {"$ref": "#/definitions/rate_or_number"},
        "top_2_accepted_recall": {"$ref": "#/definitions/rate_or_number"},
        "required_candidate_recall": {"$ref": "#/definitions/rate_or_number"},
        "forbidden_candidate_violation_rate": {"$ref": "#/definitions/rate_or_number"},
        "forbidden_candidate_violation_count": {"type": "integer"},
        "unsafe_auto_select_rate": {"$ref": "#/definitions/rate_or_number"},
        "unsafe_auto_select_count": {"type": "integer"},
        "no_match_false_positive_rate": {"$ref": "#/definitions/rate_or_number"},
        "unnecessary_clarification_rate": {"$ref": "#/definitions/rate_or_number"},
        "missed_clarification_rate": {"$ref": "#/definitions/rate_or_number"},
        "ambiguous_recall": {"$ref": "#/definitions/rate_or_number"},
        "candidate_recall_at_pool": {"$ref": "#/definitions/rate_or_number"},
        "candidate_recall_at_5": {"$ref": "#/definitions/rate_or_number"},
        "candidate_recall_at_3": {"$ref": "#/definitions/rate_or_number"},
        "candidate_recall_at_2": {"$ref": "#/definitions/rate_or_number"},
        "ranking_error_rate": {"$ref": "#/definitions/rate_or_number"},
        "decision_policy_error_rate": {"$ref": "#/definitions/rate_or_number"},
        "mrr": {"type": "number"},
        "hit_rate_at_1": {"$ref": "#/definitions/rate_or_number"},
        "hit_rate_at_2": {"$ref": "#/definitions/rate_or_number"},
        "hit_rate_at_3": {"$ref": "#/definitions/rate_or_number"},
        "ndcg_at_3": {"type": "number"},
        "brier": {"type": "number"},
        "ece": {"type": "number"},
        "annotation_mix": {"type": "object", "additionalProperties": true}
      }
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50_ms", "p95_ms", "p99_ms", "mean_ms"],
      "properties": {
        "p50_ms": {"type": "number"},
        "p95_ms": {"type": "number"},
        "p99_ms": {"type": "number"},
        "mean_ms": {"type": "number"},
        "budget_p95_ms": {"type": "number"}
      }
    },
    "concurrency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workers": {"type": "integer"},
        "queue_wait_p95_ms": {"type": "number"},
        "throughput_qps": {"type": "number"},
        "total_wall_ms": {"type": "number"}
      }
    },
    "error_buckets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["count"],
        "properties": {
          "count": {"type": "integer", "minimum": 0},
          "example_case_ids": {
            "type": "array",
            "items": {"type": "string"},
            "maxItems": 10
          }
        }
      }
    },
    "debug_log_path": {"type": "string"}
  },
  "definitions": {
    "prf1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["precision", "recall", "f1", "support"],
      "properties": {
        "precision": {"type": "number"},
        "recall": {"type": "number"},
        "f1": {"type": "number"},
        "support": {"type": "integer", "minimum": 0}
      }
    },
    "rate_or_number": {
      "oneOf": [
        {"type": "number"},
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": true,
          "required": ["metric", "numerator", "denominator", "support_status"],
          "properties": {
            "metric": {"type": "string"},
            "value": {"type": ["number", "null"]},
            "numerator": {"type": "integer", "minimum": 0},
            "denominator": {"type": "integer", "minimum": 0},
            "support": {"type": "integer", "minimum": 0},
            "support_status": {
              "type": "string",
              "enum": ["OK", "LOW_SUPPORT", "NOT_APPLICABLE"]
            },
            "confidence_interval_95": {
              "anyOf": [
                {"type": "null"},
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["lower", "upper"],
                  "properties": {
                    "lower": {"type": "number"},
                    "upper": {"type": "number"}
                  }
                }
              ]
            }
          }
        }
      ]
    }
  }
}
