[Unit]
Description=Taksitlio Chatbot API (guest UI + /v1)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=administrator
Group=administrator
WorkingDirectory=/data/nanobaseai/taksitlio-chatbot
EnvironmentFile=/data/nanobaseai/taksitlio-chatbot/.env.runtime
Environment=CDN_BASE_URL=https://portal.nanobase.ai/taksitlio-cdn
ExecStart=/data/nanobaseai/taksitlio-chatbot/.venv/bin/uvicorn taksitlio.main:app --host 127.0.0.1 --port 8040 --log-level info
Restart=always
RestartSec=3
LimitNOFILE=65535
StandardOutput=append:/data/nanobaseai/taksitlio-chatbot/logs/api.log
StandardError=append:/data/nanobaseai/taksitlio-chatbot/logs/api.log

[Install]
WantedBy=multi-user.target
