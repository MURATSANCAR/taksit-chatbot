# Infrastructure only — model endpoints live in ai_model_profiles (Postgres).
# For ADR-009 live runtime verification copy to .env.runtime (gitignored):
#   cp .env.example .env.runtime && chmod 600 .env.runtime

DATABASE_URL=postgresql://taksitlio:taksitlio@127.0.0.1:5432/taksitlio
PGVECTOR_URL=postgresql://taksitlio:taksitlio@127.0.0.1:5432/taksitlio
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=taksitlio
SESSION_TTL_SECONDS=86400
# ADR-010 product-query caches (not source of truth; bump CATALOG_CACHE_VERSION on catalog change)
ALIAS_CACHE_TTL_SECONDS=300
POPULAR_QUERY_CACHE_TTL_SECONDS=120
BEST_OFFER_CACHE_TTL_SECONDS=180
CATALOG_CACHE_VERSION=catalog-v0
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Compose service password (docker/docker-compose.runtime.yml)
POSTGRES_USER=taksitlio
POSTGRES_PASSWORD=taksitlio
POSTGRES_DB=taksitlio

# Local demo without Postgres/Redis (tests / laptop):
# ALLOW_IN_MEMORY=true
ALLOW_IN_MEMORY=false

# --- ADR-009 real runtime (never commit secrets or vendor model slugs) ---
# Opaque runtime aliases only — resolved via profile/deployment, not app code.
FAST_PROVIDER_BASE_URL=
FAST_MODEL_REFERENCE=
FAST_RUNTIME_ALIAS=poc-fast-understanding
FAST_CONTEXT_LIMIT=4096
FAST_MAX_OUTPUT_TOKENS=128
FAST_TIMEOUT_MS=3000
FAST_PARALLEL_SLOTS=4
FAST_QUANTIZATION=unspecified
FAST_CREDENTIAL_REF=secret://poc/fast-token

# Optional third FAST candidate (e.g. Qwen3.5-9B evaluation slot)
FAST_C_BASE_URL=
FAST_C_MODEL_REFERENCE=
FAST_C_RUNTIME_ALIAS=poc-fast-nine-b
FAST_C_SERVICE=taksitlio-fast-c

EMBEDDING_PROVIDER_BASE_URL=
EMBEDDING_MODEL_REFERENCE=
EMBEDDING_DIM=
EMBEDDING_RUNTIME_ALIAS=poc-category-embedding
EMBEDDING_TIMEOUT_MS=2000
EMBEDDING_MAX_BATCH=32
EMBEDDING_PARALLEL_SLOTS=4
EMBEDDING_QUANTIZATION=unspecified
EMBEDDING_SPACE_ID=default
EMBEDDING_CREDENTIAL_REF=secret://poc/embedder-token

INTEGRATION_REQUIRE_REDIS=1
INTEGRATION_REQUIRE_PG=1
