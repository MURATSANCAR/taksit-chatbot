# Infrastructure only — model endpoints live in ai_model_profiles (Postgres).
# For ADR-009 live runtime verification copy to .env.runtime (gitignored):
#   cp .env.example .env.runtime && chmod 600 .env.runtime

# Required for prod path + ADR-012 V023/V024 (see docs/runbooks/ADR-012-answer-integrity-ops.md)
DATABASE_URL=postgresql://taksitlio:taksitlio@127.0.0.1:5432/taksitlio
PGVECTOR_URL=postgresql://taksitlio:taksitlio@127.0.0.1:5432/taksitlio
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=taksitlio
SESSION_TTL_SECONDS=86400
# ADR-010 product-query caches (not source of truth; bump CATALOG_CACHE_VERSION on catalog change)
ALIAS_CACHE_TTL_SECONDS=300
POPULAR_QUERY_CACHE_TTL_SECONDS=120
BEST_OFFER_CACHE_TTL_SECONDS=180
CATALOG_CACHE_VERSION=catalog-v0
OBJECT_STORAGE_BACKEND=local
# OBJECT_STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_PREFIX=taksitlio
# S3_ENDPOINT_URL=          # MinIO e.g. http://127.0.0.1:9000
# S3_REGION=
# AWS_ACCESS_KEY_ID=        # or IAM role; never commit
# AWS_SECRET_ACCESS_KEY=
MEDIA_STORAGE_ROOT=/tmp/taksitlio-media
# Prod local disk example: MEDIA_STORAGE_ROOT=/data/media
CDN_BASE_URL=https://cdn.example.test
# Local compose often uses: CDN_BASE_URL=http://localhost:8000/cdn
# Live feed staging (JSON + download cache) — never commit; server path only
# LIVE_FEED_DIR=/var/lib/taksitlio/feeds/live
# Hard stop across all src-m-*.json feeds (0 disables)
# CRAWL_GLOBAL_PRODUCT_CAP=1000000

SCHEDULER_WORKER_ID=scheduler-1
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ADR-010 P15 — merchant feed auth (never commit real tokens; use env:// refs in DB)
# MERCHANT_FEED_TOKEN=
# credential_ref examples: env://MERCHANT_FEED_TOKEN | bearer:env://MERCHANT_FEED_TOKEN | header:X-Api-Key:env://MERCHANT_FEED_TOKEN

# Compose service password (docker/docker-compose.runtime.yml)
POSTGRES_USER=taksitlio
POSTGRES_PASSWORD=taksitlio
POSTGRES_DB=taksitlio

# Local demo without Postgres/Redis (tests / laptop):
# ALLOW_IN_MEMORY=true
ALLOW_IN_MEMORY=false

# --- ADR-009 real runtime (never commit secrets or vendor model slugs) ---
# Opaque runtime aliases only — resolved via profile/deployment, not app code.
FAST_PROVIDER_BASE_URL=
FAST_MODEL_REFERENCE=
FAST_RUNTIME_ALIAS=poc-fast-understanding
FAST_CONTEXT_LIMIT=4096
FAST_MAX_OUTPUT_TOKENS=128
FAST_TIMEOUT_MS=3000
FAST_PARALLEL_SLOTS=4
FAST_QUANTIZATION=unspecified
FAST_CREDENTIAL_REF=secret://poc/fast-token

# Optional third FAST candidate (e.g. Qwen3.5-9B evaluation slot).
# When FAST_C_* (or UNDERSTANDING_*) is set, ADR-011 LlmUnderstandingWorker
# uses this OpenAI-compatible endpoint instead of DeterministicFallbackProvider.
# Nanobase ops (localhost-bound): ssh -f -N -L 8023:127.0.0.1:8023 nanobase
# then FAST_C_BASE_URL=http://127.0.0.1:8023  FAST_C_MODEL_REFERENCE=poc-fast-nine-b
# See gitignored .env.runtime for a local template.
FAST_C_BASE_URL=
FAST_C_MODEL_REFERENCE=
FAST_C_RUNTIME_ALIAS=poc-fast-nine-b
FAST_C_SERVICE=taksitlio-fast-c
FAST_C_TIMEOUT_MS=8000
FAST_C_MAX_OUTPUT_TOKENS=512
FAST_C_API_KEY=

# ADR-011 understanding override (wins over FAST_C when both set)
UNDERSTANDING_PROVIDER_BASE_URL=
UNDERSTANDING_MODEL_REFERENCE=
UNDERSTANDING_RUNTIME_ALIAS=poc-fast-nine-b
UNDERSTANDING_TIMEOUT_MS=8000
UNDERSTANDING_MAX_OUTPUT_TOKENS=512
UNDERSTANDING_API_KEY=
UNDERSTANDING_TEMPERATURE=0

EMBEDDING_PROVIDER_BASE_URL=
EMBEDDING_MODEL_REFERENCE=
EMBEDDING_DIM=
EMBEDDING_RUNTIME_ALIAS=poc-category-embedding
EMBEDDING_TIMEOUT_MS=2000
EMBEDDING_MAX_BATCH=32
EMBEDDING_PARALLEL_SLOTS=4
EMBEDDING_QUANTIZATION=unspecified
EMBEDDING_SPACE_ID=default
EMBEDDING_CREDENTIAL_REF=secret://poc/embedder-token

INTEGRATION_REQUIRE_REDIS=1
INTEGRATION_REQUIRE_PG=1
