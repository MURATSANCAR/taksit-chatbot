{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taksitlio.local/schemas/conversation_update.schema.json",
  "title": "ConversationPatch",
  "description": "Typed session patch. Backend owns current values; model must not supply old_value.",
  "type": "object",
  "additionalProperties": false,
  "required": ["operation", "path", "confidence"],
  "properties": {
    "operation": {
      "type": "string",
      "enum": ["SET", "REMOVE", "APPEND", "REPLACE_COLLECTION", "RESET_NEED"]
    },
    "path": {
      "type": "string",
      "description": "JSON Pointer under allowlisted need-profile paths, e.g. /budget/value",
      "minLength": 1
    },
    "value": {},
    "evidence_text": {
      "type": ["string", "null"],
      "maxLength": 500
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "need_profile": {
      "description": "Only for RESET_NEED — full replacement validated by backend schema",
      "$ref": "need_profile.schema.json"
    }
  }
}
