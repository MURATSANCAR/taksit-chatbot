{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://taksitlio.local/schemas/need_profile_sft_example.json",
  "title": "NeedProfileSFTExample",
  "description": "One supervised fine-tune row for FAST NeedProfile extraction (P17 scaffold).",
  "type": "object",
  "required": ["id", "utterance", "locale", "messages", "need_profile", "source_ref", "annotation_status"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "utterance": { "type": "string", "minLength": 1 },
    "locale": { "type": "string", "default": "tr-TR" },
    "messages": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["system", "user", "assistant"] },
          "content": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "need_profile": {
      "type": "object",
      "description": "Must validate against need_profile.schema.json; no fixture/category IDs"
    },
    "source_ref": {
      "type": "object",
      "required": ["path", "case_id"],
      "properties": {
        "path": { "type": "string" },
        "case_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "annotation_status": {
      "type": "string",
      "enum": ["HUMAN_REVIEWED", "SYNTHETIC", "DRAFT"]
    },
    "split": {
      "type": "string",
      "enum": ["train", "eval", "holdout"],
      "default": "train"
    }
  }
}
